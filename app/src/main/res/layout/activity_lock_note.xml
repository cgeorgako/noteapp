<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/note_paper">

    <!-- Top bar: primary actions, always visible at the top-right -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/note_paper"
        android:elevation="3dp"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/note_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnPdf"
            style="@style/PadButtonTop"
            android:src="@drawable/ic_pdf"
            android:contentDescription="@string/export_pdf" />

        <ImageButton
            android:id="@+id/btnDone"
            style="@style/PadButtonDoneTop"
            android:src="@drawable/ic_done"
            android:contentDescription="@string/done" />
    </LinearLayout>

    <com.example.locknote.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/toolbarScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom bar: drawing tools -->
    <HorizontalScrollView
        android:id="@+id/toolbarScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/toolbar_bg"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp"
            android:gravity="center">

            <ImageButton android:id="@+id/btnPen" style="@style/PadButton"
                android:src="@drawable/ic_pen" android:contentDescription="@string/pen" />
            <ImageButton android:id="@+id/btnEraser" style="@style/PadButton"
                android:src="@drawable/ic_eraser" android:contentDescription="@string/eraser" />
            <ImageButton android:id="@+id/btnSize" style="@style/PadButton"
                android:src="@drawable/ic_size" android:contentDescription="@string/thickness" />

            <View android:layout_width="1dp" android:layout_height="32dp"
                android:layout_gravity="center_vertical" android:background="#33FFFFFF"
                android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />

            <ImageButton android:id="@+id/btnUndo" style="@style/PadButton"
                android:src="@drawable/ic_undo" android:contentDescription="@string/undo" />
            <ImageButton android:id="@+id/btnRedo" style="@style/PadButton"
                android:src="@drawable/ic_redo" android:contentDescription="@string/redo" />
            <ImageButton android:id="@+id/btnClear" style="@style/PadButton"
                android:src="@drawable/ic_clear" android:contentDescription="@string/clear" />

            <View android:layout_width="1dp" android:layout_height="32dp"
                android:layout_gravity="center_vertical" android:background="#33FFFFFF"
                android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />

            <ImageButton android:id="@+id/btnShare" style="@style/PadButton"
                android:src="@drawable/ic_share" android:contentDescription="@string/share" />
            <ImageButton android:id="@+id/btnSettings" style="@style/PadButton"
                android:src="@drawable/ic_settings" android:contentDescription="@string/settings" />
        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
