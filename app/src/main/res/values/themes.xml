<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.LockNote" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/accent</item>
    </style>

    <style name="Theme.LockNote.Fullscreen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/note_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/toolbar_bg</item>
    </style>

    <style name="PadButton">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/white</item>
    </style>

    <style name="PadButtonDone" parent="PadButton">
        <item name="android:tint">@color/accent</item>
    </style>
</resources>
